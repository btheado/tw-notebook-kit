  "author": "Brian Theado <brian.theado@gmail.com>",
  "description": "Integrate observablehq notebook-kit into tiddlywiki as a widget",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "keywords": [
    "tiddlywiki",
    "tw5",
    "wiki",
    "browser"
  ],
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^4.0.0",
    "tiddlywiki": "^5.4.0"
  },
  "scripts": {
    "build:index": "npm run tw -- --build index",
    "tw": "cross-env TIDDLYWIKI_PLUGIN_PATH=./src/plugins:./node_modules/tiddlywiki/plugins tiddlywiki ./wiki --verbose",
    "tw_start": "npm run tw -- --server 8087 $:/core/save/all text/plain text/html '' '' 0.0.0.0"
  }
}
