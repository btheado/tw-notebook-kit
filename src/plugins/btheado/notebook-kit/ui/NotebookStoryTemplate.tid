title: $:/plugins/btheado/notebook-kit/ui/NotebookStoryTemplate
code-body: yes

\procedure createCell()
<$action-createtiddler  $basetitle={{{ [<currentTiddler>addsuffix[/cell]] }}} type="application/javascript">
	<$action-sendmessage $message="tm-edit-tiddler" $param=<<createTiddler-title>>/>
</$action-createtiddler>
\end

<$notebook-kit>
  <$messagecatcher $nk-navigate-in-parent-to="<$action-navigate $to=<<event-paramObject-navigateTo>>/>">
  <$navigator story=<<currentTiddler>> history={{{ [<currentTiddler>addsuffix[/NavigatorHistory]] }}}>
    <div class="tc-notebook-toolbar">
      <div><$button class="tc-btn-invisible tc-notebook-add-cell" actions=<<createCell>>>+ Create Cell</$button></div>
    </div>
    <$list
      filter="[list<currentTiddler>]"
      history={{{ [<currentTiddler>addsuffix[/NavigatorHistory]] }}}
      template="$:/plugins/btheado/notebook-kit/ui/ViewTemplate"
      editTemplate="$:/plugins/btheado/notebook-kit/ui/EditTemplate"
      emptyMessage="""<div class="tc-notebook-empty">No notebook cells yet.</div>"""/>
  </$navigator>
  </$messagecatcher>
</$notebook-kit>
