title: $:/plugins/btheado/notebook-kit/ViewTemplate
code-body: yes

\procedure moveup()
  <$action-setfield
    $tiddler=<<tv-story-list>>
    list={{{ [list<tv-story-list>] +[move:-1<currentTiddler>] :and[format:titlelist[]join[ ]] }}}
  />
  <$action-navigate/>

  <!-- I've no clue why this isn't working
  <$action-listops
    $tidder=<<tv-story-list>>
    $filter="[list<tv-story-list>] +[move:-1<currentTiddler>]"
  />
  -->
\end
\procedure movedown()
  <$action-setfield
    $tiddler=<<tv-story-list>>
    list={{{ [list<tv-story-list>] +[move:1<currentTiddler>] :and[format:titlelist[]join[ ]] }}}
  />
  <$action-navigate/>
\end

<div class="tc-notebook-cell">
{{||$:/plugins/btheado/notebook-kit/CellOutput}}
<div class="tc-notebook-cell-controls">
  <$button
    actions=<<moveup>>
    tooltip="move cell up"
    aria-label="move cell up"
    class="tc-btn-invisible tc-btn-mini">
    {{$:/core/images/up-arrow}}
  </$button>
  <$button
    actions=<<movedown>>
    tooltip="move cell down"
    aria-label="move cell down"
    class="tc-btn-invisible tc-btn-mini">
    {{$:/core/images/down-arrow}}
  </$button>
  <%if [<folded-state>get[text]match[hide]] %>
    <$button
      actions=""" <$action-setfield $tiddler=<<folded-state>> text="show"/> """
      tooltip="show source code"
      aria-label="show source code"
      class="tc-btn-invisible tc-btn-mini">
      {{$:/core/images/unfold-button}}
    </$button>
  <%else%>
    <$button
      actions=""" <$action-setfield $tiddler=<<folded-state>> text="hide"/> """
      tooltip="hide source code"
      aria-label="hide source code"
      class="tc-btn-invisible tc-btn-mini">
      {{$:/core/images/fold-button}}
    </$button>
  <%endif%>
  <$button
    actions=""" <$action-sendmessage $message="nk-navigate-in-parent-to" $name="navigateTo" $value=<<currentTiddler>>/> """
    tooltip="open in parent storyriver"
    aria-label="open in parent storyriver"
    class="tc-btn-invisible tc-btn-mini">
    {{$:/core/images/open-window}}
  </$button>
  <$button
    message="tm-edit-tiddler"
    tooltip={{$:/language/Buttons/Edit/Hint}}
    aria-label={{$:/language/Buttons/Edit/Caption}}
    class="tc-btn-invisible tc-btn-mini">
    {{$:/core/images/edit-button}}
   </$button>
  <$button
    message="tm-close-tiddler"
    tooltip="remove cell from notebook (tiddler is kept)"
    aria-label="remove cell from notebook (tiddler is kept)"
    class="tc-btn-invisible tc-btn-mini">
    {{$:/core/images/close-button}}
   </$button>
</div>
<%if [<folded-state>get[text]else[show]match[show]] %>
  <$codeblock code={{{ [<currentTiddler>get[text]] }}} language={{{ [<currentTiddler>get[type]else[text/vnd.tiddlywiki]] }}}/>
<%endif%>
</div>
